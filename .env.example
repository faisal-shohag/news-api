# All values are optional; these are the defaults.
PORT=3000
NODE_ENV=development

# Timeout for outbound requests to bbc.com, in milliseconds.
UPSTREAM_TIMEOUT_MS=10000

# Cache TTLs, in seconds.
LIST_CACHE_TTL_SECONDS=120
ARTICLE_CACHE_TTL_SECONDS=600

# "*" for a fully open public API, or a comma-separated list of origins.
CORS_ORIGIN=*

# --- /api/v2 engine ---
# Max simultaneous outbound requests to bbc.com.
MAX_CONCURRENCY=4
# Extra attempts after a failure. Only 5xx and network errors retry.
UPSTREAM_RETRIES=1
# Deep-crawl bounds.
MAX_TOPIC_PAGES=40
DEFAULT_CRAWL_PAGES=5
# Cache bounds. Both evict least-recently-used first.
CACHE_MAX_ENTRIES=500
CACHE_MAX_INDEXED=5000
# Requests per minute per IP.
V2_RATE_LIMIT_MAX=120
CRAWL_RATE_LIMIT_MAX=10
