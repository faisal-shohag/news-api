# All values are optional; these are the defaults.
PORT=3000
NODE_ENV=development

# Timeout for outbound requests to bbc.com, in milliseconds.
UPSTREAM_TIMEOUT_MS=10000

# Cache TTLs, in seconds.
LIST_CACHE_TTL_SECONDS=120
ARTICLE_CACHE_TTL_SECONDS=600

# "*" for a fully open public API, or a comma-separated list of origins.
CORS_ORIGIN=*
